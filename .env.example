DATABASE_URL=postgresql+psycopg://shopos:shopos_local_only@localhost:5433/shopos
SHOPOS_DB_HOST_PORT=5433
# Android build-time API URL. Replace with your HTTPS zrok URL, then Render URL.
SHOPOS_API_BASE_URL=http://10.0.2.2:8000/
S3_BUCKET=shopos-proofs
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://10.0.2.2:9000
S3_ACCESS_KEY_ID=shopos_local
S3_SECRET_ACCESS_KEY=replace_with_local_only_secret
# To use Cloudflare R2 instead of local SeaweedFS, set all R2_* values below
# in your ignored .env. R2_BUCKET selects R2; leave it unset for local storage.
# R2_BUCKET=shopos-parchi
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>
